{
  "name": "saro-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:resident": "npm run dev --workspace @saro/resident-app",
    "dev:admin": "npm run dev --workspace @saro/admin-app",
    "build": "npm run build --workspaces --if-present",
    "build:resident": "npm run build --workspace @saro/resident-app",
    "build:admin": "npm run build --workspace @saro/admin-app",
    "lint": "eslint .",
    "test:shared": "npm run test --workspace @saro/shared",
    "audit:contrast": "node tools/contrast-audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mapbox/vector-tile": "^3.0.0",
    "@terraformer/arcgis": "^2.2.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "geojson-vt": "^4.0.3",
    "globals": "^17.7.0",
    "pbf": "^5.1.2",
    "vt-pbf": "^3.1.3"
  },
  "dependencies": {
    "pmtiles": "^4.4.1"
  }
}
