# SARO admin-app environment template.
# Copy to .env.local and fill in. .env.local is gitignored.
#
# Everything prefixed VITE_ is compiled into the JavaScript bundle that
# browsers download. Only put values here that are safe to publish.

VITE_APP_ENV=development

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_... or the legacy anon JWT).
# Staff still authenticate with email and password; this key only identifies
# the project. Role and scope come from the profiles table via RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Absolute URL of the deployed resident app, for "Back to Public Portal".
VITE_RESIDENT_APP_URL=

# ── Deliberately NOT here ───────────────────────────────────────────────────
# SUPABASE SECRET KEY — bypasses all RLS, including the office and barangay
#                       scoping. It belongs in a shell session when running
#                       supabase/scripts/create-staff-users.mjs, nowhere else.
