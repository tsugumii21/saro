# SARO resident-app environment template.
# Copy to .env.local and fill in. .env.local is gitignored.
#
# Everything prefixed VITE_ is compiled into the JavaScript bundle that
# browsers download. Only put values here that are safe to publish.

VITE_APP_ENV=development

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_... or the legacy anon JWT).
# Public by design — it identifies the project and grants nothing on its own.
# Every permission decision is made by Row Level Security in Postgres.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Absolute URL of the deployed admin app, for the "for city officials" link.
VITE_ADMIN_APP_URL=

# Public half of the Web Push VAPID key pair.
# Safe to ship: it is the identifier the push service checks the private key's
# signature against, and it grants nothing on its own. The private half is a
# Supabase secret (supabase secrets set VAPID_PRIVATE_KEY=...).
# The two are generated together — replacing one invalidates every existing
# subscription, so regenerate both or neither.
VITE_VAPID_PUBLIC_KEY=

# ── Deliberately NOT here ───────────────────────────────────────────────────
# SUPABASE SECRET KEY  — bypasses all RLS. Server-side only, never VITE_.
# GEMINI_API_KEY       — now a Supabase secret used inside the gemini-proxy
#                        Edge Function:  supabase secrets set GEMINI_API_KEY=...
#                        The browser calls the function, never Gemini directly.
