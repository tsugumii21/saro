# Environment variables
.env
.env.local
.env*.local

# Node modules & build outputs
node_modules
dist
dist-ssr

# Deployment & Platform tooling
.vercel
.supabase
supabase/.branches
supabase/.temp

# IDE & OS files
.DS_Store
*.log

# Vendored AI agent skill installs — ~868 files, all mirrors of the same
# upstream skills. Reinstallable, not project source. Remove a line here if you
# want that tool's config tracked.
.agents/
.claude/
.cursor/
.gemini/
.kiro/
.opencode/

# impeccable local cache / machine-specific config
.impeccable/hook.cache.json
.impeccable/config.local.json

# Intermediate hazard GeoJSON (~55 MB). Regenerate with
# `node tools/hazard/fetch-hazards.mjs`. The committed, versioned asset is the
# PMTiles archive in each app's public/hazard/ — the GeoJSON is only the
# staging format between the upstream services and the tiler.
packages/shared/assets/hazard/*.geojson
