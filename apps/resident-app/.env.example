# SARO resident-app environment template
VITE_APP_ENV=development

# Absolute URL of the deployed admin app. Used by the "For city officials"
# call to action on the landing page. Leave blank locally.
VITE_ADMIN_APP_URL=

# TEMPORARY DEV-ONLY: Gemini API key for the client-side FAQ assistant.
# This is bundled into the browser build and is NOT safe for production.
# Scheduled to be replaced by a Supabase Edge Function. Never commit a real key.
# VITE_GEMINI_API_KEY=
